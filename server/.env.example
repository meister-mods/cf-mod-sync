# A CurseForge Core API key approved for a third-party application.
# https://support.curseforge.com/support/solutions/articles/9000208346-about-the-curseforge-api-and-how-to-apply-for-a-key
CURSEFORGE_API_KEY=YOUR_CURSEFORGE_API_KEY

# The downloaded file must be tagged with this exact Minecraft version.
MC_VERSION=1.20.1

# Fixed mod loader: Forge (NOT Fabric or NeoForge).
# all = newest including Alpha/Beta, beta = Beta or Release, release = Release only
RELEASE_CHANNEL=release

# File containing CurseForge project URLs, one URL per line.
MOD_LIST=../client/.mods

# By default output is downloads/<MC_VERSION>-forge
# Optional override (separate directories are recommended for each MC version):
# OUTPUT_DIR=downloads/custom-forge-profile

AUTO_DEPS=true

# Set your installed Forge version to filter actual JAR requirements.
# FORGE_VERSION=47.3.0

# Server mode: go run . serve
# This is a client access token, separate from CURSEFORGE_API_KEY.
# At least 32 characters are required when listening outside loopback.
SERVER_LISTEN=127.0.0.1:8080
SERVER_CACHE_DIR=cache
# SERVER_TOKEN=replace-with-a-random-64-character-token
